   "source": [
    "\n",
    "med_cols = ['metformin','repaglinide','nateglinide','chlorpropamide','glimepiride',\n",
    "            'acetohexamide','glipizide','glyburide','tolbutamide','pioglitazone',\n",
    "            'rosiglitazone','acarbose','miglitol','troglitazone','tolazamide',\n",
    "            'examide','citoglipton','insulin','glyburide-metformin','glipizide-metformin',\n",
    "            'glimepiride-pioglitazone','metformin-rosiglitazone','metformin-pioglitazone']\n",
    "\n",
    "rows = []\n",
    "for col in med_cols:\n",
    "    subset = diabetic_raw[diabetic_raw[col] != 'No']\n",
    "    if len(subset) == 0:\n",
    "        continue\n",
    "    rows.append({\n",
    "        'med': col,\n",
    "        'not_readmitted': (subset['readmitted'] == 'NO').sum(),\n",
    "        'gt30': (subset['readmitted'] == '>30').sum(),\n",
    "        'lt30': (subset['readmitted'] == '<30').sum(),\n",
    "        'total': len(subset)\n",
    "    })\n",
    "\n",
    "plot_df = pd.DataFrame(rows).sort_values('total').reset_index(drop=True)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 8))\n",
    "y = np.arange(len(plot_df))\n",
    "h = 0.65\n",
    "\n",
    "segments = [\n",
    "    ('not_readmitted', 'Not readmitted',     '#B5D4F4'),\n",
    "    ('gt30',           'Readmitted >30 days', '#185FA5'),\n",
    "    ('lt30',           'Readmitted <30 days', '#E24B4A'),\n",
    "]\n",
    "\n",
    "left = np.zeros(len(plot_df))\n",
    "for key, label, color in segments:\n",
    "    vals = plot_df[key].values\n",
    "    ax.barh(y, vals, left=left, height=h, color=color, edgecolor='none', label=label)\n",
    "    for i, (v, l) in enumerate(zip(vals, left)):\n",
    "        if v > 300:\n",
    "            txt_color = 'white' if key != 'not_readmitted' else '#185FA5'\n",
    "            ax.text(l + v/2, y[i], f'{v:,}', ha='center', va='center',\n",
    "                    fontsize=8, color=txt_color, fontweight='500')\n",
    "    left += vals\n",
    "\n",
    "ax.set_yticks(y)\n",
    "ax.set_yticklabels([c.capitalize() for c in plot_df['med']], fontsize=10)\n",
    "ax.set_xlabel('Number of patients', fontsize=11, color='#5F5E5A')\n",
    "ax.set_title('Medications prescribed — readmission breakdown\\n(101,766 encounters)', fontsize=13, fontweight='normal', pad=15)\n",
    "ax.spines[['top','right','left']].set_visible(False)\n",
    "ax.tick_params(axis='y', length=0)\n",
    "ax.tick_params(axis='x', colors='#888780')\n",
    "ax.grid(axis='x', color='#e5e5e5', linewidth=0.7)\n",
    "ax.set_axisbelow(True)\n",
    "\n",
    "handles = [mpatches.Patch(color=c, label=l) for _, l, c in segments]\n",
    "ax.legend(handles=handles, loc='lower right', fontsize=10, frameon=False)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
