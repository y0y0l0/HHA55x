   "source": [
    "bins   = [0, 10, 20, 30, float(\"inf\")]\n",
    "labels = [\"1–10\", \"11–20\", \"21–30\", \"30+\"]\n",
    "diabetic_raw[\"med_group\"] = pd.cut(diabetic_raw[\"num_medications\"], bins=bins, labels=labels, right=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "7ba6aae6-ae64-4af1-92ea-c8217981cda8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Filter for target discharge dispositions \n",
    "# 11 = Expired\n",
    "# 13 = Hospice / home\n",
    "# 14 = Hospice / medical facility\n",
    "# 19 = Expired at home  (Medicaid only, hospice)\n",
    "# 20 = Expired in a medical facility  (Medicaid only, hospice)\n",
    "# 21 = Expired, place unknown  (Medicaid only, hospice)\n",
    "target_ids = [11, 13, 14, 19, 20, 21]\n",
    " \n",
    "label_map = {\n",
    "    11: \"Expired\",\n",
    "    13: \"Hospice / home\",\n",
    "    14: \"Hospice / facility\",\n",
    "    19: \"Expired at home\",\n",
    "    20: \"Expired at medical facility\",\n",
    "    21: \"Expired, place unknown\",\n",
    "}\n",
    " \n",
    "filt = diabetic_raw[diabetic_raw[\"discharge_disposition_id\"].isin(target_ids)].copy()\n",
    "filt[\"disposition_label\"] = filt[\"discharge_disposition_id\"].map(label_map)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "615d82b6-186f-462b-a85e-3b8d79fa2048",
   "metadata": {},
   "outputs": [],
   "source": [
    " # Pivot: rows = med_group, columns = disposition label\n",
    "counts = (\n",
    "    filt.groupby([\"med_group\", \"disposition_label\"])\n",
    "    .size()\n",
    "    .unstack(fill_value=0)\n",
    "    .reindex(labels)          # keep medication groups in order\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "d92d66df-1763-43d4-890b-9c1b6b212b6b",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Drop any disposition that had zero records across all groups\n",
    "counts = counts.loc[:, counts.sum() > 0]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "6e1a6d8b-beb1-43c8-8325-6ebe8a404e3f",
   "metadata": {},
   "outputs": [],
   "source": [
    " #convert to % of the full group size \n",
    "group_totals = diabetic_raw.groupby(\"med_group\").size().reindex(labels)\n",
    "pcts = counts.div(group_totals, axis=0) * 100   # use pcts instead of counts below"
   ]
  },
